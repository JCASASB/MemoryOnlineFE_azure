{
  "name": "memory-hexagonal",
  "private": true,
  "license": "UNLICENSED",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "jest",
    "test:core": "jest tests/core",
    "test:core:coverage": "jest tests/core --coverage",
    "preview": "vite preview",
    "sync-s3": "aws s3 sync dist/ s3://$S3_BUCKET --delete --cache-control \"public, max-age=31536000, immutable\" --exclude \"index.html\" && aws s3 cp dist/index.html s3://$S3_BUCKET/index.html --cache-control \"no-cache, no-store, max-age=0, must-revalidate\"",
    "deploy": "npm run build && npm run sync-s3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1036.0",
    "@microsoft/signalr": "^10.0.0",
    "@types/react-router-dom": "^5.3.3",
    "axios": "^1.15.0",
    "dexie": "^4.4.2",
    "dexie-react-hooks": "^4.4.0",
    "jwt-decode": "^4.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "styled-components": "^6.3.11",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/styled-components": "^5.1.36",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
